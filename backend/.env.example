PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/riyadvi_db
CLIENT_ORIGIN=http://localhost:3000

# Mailchimp Email Marketing Integration
# Get these from your Mailchimp account:
#   API Key: Account > Profile > Extras > API Keys
#   Server Prefix: Last part of the API key (e.g. if key ends in -us1, prefix is "us1")
#   List ID: Audience > Manage Audience > Settings > Audience name and defaults
MAILCHIMP_API_KEY=your_mailchimp_api_key_here-us1
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=your_audience_list_id_here

# SMTP Config (for direct email alerts, optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
